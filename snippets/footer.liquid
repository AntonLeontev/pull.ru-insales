<footer class="footer" x-data="{
	processing: false,

	subscribe(e) {
		this.processing = true

		let data = new FormData(e.target)
		$.post('https://app.limmite.ru/api/footer-subscribe', Object.fromEntries(data.entries()))
			.done(done => {
				e.target.querySelector('span').innerText = '✓'
				ym(96482433, 'reachGoal', 'submit-footer-form');
			})
			.fail(err => console.log(err))
			.always(() => {
				e.target.reset()
				this.processing = false
			})
	},
}">
    <div class="container">
        <div class="footer__content">
			<div class="footer-subscribe footer-subscribe_mobile">
				<div class="subscribe__title">Скидка 5% за подписку на новинки</div>
				<form class="subscribe__input" @submit.prevent="subscribe">
					<div class="wrap">
						<input type="email" name="email" placeholder="Ваш e-mail" required>
						<button type="submit" class="" :disabled="processing">
							<span x-show="!processing">Отправить</span>
							<img src="{{ 'loading.svg' | asset_url }}" height="20px" width="20px" alt="loading" x-show="processing" x-cloak>
						</button>
					</div>

					<div class="radio-wrap">
						<label>
							<input type="radio" name="sex" value="1" checked>
							<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="empty">
								<circle cx="7" cy="7" r="6.5" fill="white" stroke="#939393"/>
							</svg>
							<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="filled">
								<circle cx="7" cy="7" r="6.5" fill="white" stroke="#131313"/>
								<circle cx="7" cy="7" r="4" fill="#131313"/>
							</svg>
							<span>Для мужчин</span>
						</label>
						<label>
							<input type="radio" name="sex" value="2">
							<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="empty">
								<circle cx="7" cy="7" r="6.5" fill="white" stroke="#939393"/>
							</svg>
							<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="filled">
								<circle cx="7" cy="7" r="6.5" fill="white" stroke="#131313"/>
								<circle cx="7" cy="7" r="4" fill="#131313"/>
							</svg>
							<span>Для женщин</span>
						</label>
					</div>
				</form>
			</div>

            <div class="footer__menu-wrap">
                <nav class="footer__menu">
                    <div class="menu__header">Покупателям</div>
                    <ul class="menu__links">
                        <li class="menu__item">
                            <a href="https://static.insales-cdn.com/files/1/3325/33565949/original/policy.pdf"
                                target="_blank" class="menu__link">Политика обработки персональных данных</a>
                        </li>
                        <li class="menu__item">
                            <a href="https://static.insales-cdn.com/files/1/3327/33565951/original/terms_of_use.pdf"
                                target="_blank" class="menu__link">Соглашение для покупателей</a>
                        </li>
                        <li class="menu__item">
                            <a href="/page/delivery" class="menu__link">Доставка товара</a>
                        </li>
                    </ul>
                </nav>

                <nav class="footer__menu">
                    <div class="menu__header">Продавцам</div>
                    <ul class="menu__links">
                        <li class="menu__item">
                            <a href="https://static.insales-cdn.com/files/1/3326/33565950/original/terms_for_sellers.pdf"
                                target="_blank" class="menu__link">Соглашение для продавцов</a>
                        </li>
                        <li class="menu__item">
                            <a href="https://static.insales-cdn.com/files/1/3328/33565952/original/offer.pdf"
                                target="_blank" class="menu__link">Оферта</a>
                        </li>
                    </ul>
                </nav>

                <nav class="footer__menu">
                    <div class="menu__header">О нас</div>
                    <ul class="menu__links">
                        <li class="menu__item">
                            <a href="/page/how-it-works" class="menu__link">Как это работает</a>
                        </li>
                        <li class="menu__item">
                            <a href="/page/right-holders" class="menu__link">Правообладателям</a>
                        </li>
                    </ul>
                </nav>
            </div>

            <div class="footer__info">
				<div class="footer-subscribe footer-subscribe_desctop">
					<div class="subscribe__title">Скидка 5% за подписку на новинки</div>
					<form class="subscribe__input" @submit.prevent="subscribe">
						<div class="wrap">
							<input type="email" name="email" placeholder="Ваш e-mail" required>
							<button type="submit" class="" :disabled="processing">
								<span x-show="!processing">Отправить</span>
								<img src="{{ 'loading.svg' | asset_url }}" height="20px" width="20px"  alt="loading" x-show="processing" x-cloak>
							</button>
						</div>

						<div class="radio-wrap">
							<label>
								<input type="radio" name="sex" value="1" checked>
								<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="empty">
									<circle cx="7" cy="7" r="6.5" fill="white" stroke="#939393"/>
								</svg>
								<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="filled">
									<circle cx="7" cy="7" r="6.5" fill="white" stroke="#131313"/>
									<circle cx="7" cy="7" r="4" fill="#131313"/>
								</svg>
								<span>Для мужчин</span>
							</label>
							<label>
								<input type="radio" name="sex" value="2">
								<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="empty">
									<circle cx="7" cy="7" r="6.5" fill="white" stroke="#939393"/>
								</svg>
								<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="filled">
									<circle cx="7" cy="7" r="6.5" fill="white" stroke="#131313"/>
									<circle cx="7" cy="7" r="4" fill="#131313"/>
								</svg>
								<span>Для женщин</span>
							</label>
						</div>
					</form>
				</div>


                <div class="info__item">
                    <div class="item__header">Информация о владельце сайта</div>
                    <ul class="item__values">
                        <li class="item__value">ООО&nbsp;"ТРАСТ" ИНН&nbsp;7203568240</li>
                    </ul>
                </div>
                <div class="info__item">
                    <div class="item__header">Авторизованные процессинговые компании</div>
                    <ul class="item__values">
                        <li class="item__value">ООО&nbsp;"ТРАСТ СЕРВИС" ИНН&nbsp;7203567990</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="footer_socials">
            <div class="payment_types">
                <div class="payment_systems">
                    {% for item in block_lists.footer-payment.blocks %}
                    	<img src="{{ item.image }}" alt="{{ item.title }}" />
                    {% endfor %}
                </div>
            </div>

            <div class="socials">
                {% for item in block_lists.social.blocks %}
					<a href="{{ item.link }}" target="_blank" class="social_item">
						<img src="{{ item.image }}" alt="{{ item.title }}" />
					</a>
                {% endfor %}
            </div>
        </div>
    </div>
</footer>
