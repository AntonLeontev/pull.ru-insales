{% if template contains 'product' %}	
	{% assign catalog = collections | where: 'title', 'Каталог' | first %}
	{% assign categories = catalog.subcollections %}
	{% assign men = categories | where: 'title', 'Мужчинам' | first %}
	{% assign women = categories | where: 'title', 'Женщинам' | first %}
{% else %}  
	{% assign catalog = collections.all %}
	{% assign men = collections.muzhchinam %}
	{% assign women = collections.zhenschinam %}
{% endif %}  

{% assign brands = block_lists.with_template['system-banner-3'].brands.blocks %}


<header class="header" id="header" 
	x-data="{
		sidebar: false,
		search: false,
		searchMobile: false,
	}"
>
	<div class="container">
		<div class="header__content">
			<nav class="left-menu">
				<div class="gender__item">
					<a href="/page/men" class="item__link">Мужчинам</a>
					<nav class="navigation">
						<div class="container">
							<div class="navigation__content">
								<div class="navigation__categories">
									<ul class="categories__list">
										{% for collection in men.subcollections %}
											<li class="categories__item">
												<a class="categories__link" href="{{ collection.url }}" tabindex="-1">{{ collection.title }}</a>
												
												{% if collection.subcollections.size > 0 %}
													<ul class="subcategories">
														{% for collection1 in collection.subcollections %}
															<li class="subcategories__item">
																<a href="{{ collection1.url }}" class="subcategories__link" tabindex="-1">
																	{{ collection1.title }}
																</a>
															</li>
					
															{% if collection1.subcollections.size > 0 %}
																<ul class="subcategories">
																{% for collection2 in collection1.subcollections %}
																	<li class="subcategories__item">
																		<a href="{{ collection2.url }}" tabindex="-1" class="subcategories__link">
																			{{ collection2.title }}
																		</a>
																	</li>
																{% endfor %}
																</ul>
															{% endif %}
														{% endfor %}
													</ul>
												{% endif %}
											</li>
										{% endfor %}
									</ul>
								</div>
								<div class="navigation__brands">
									<div class="brands__title">Бренды</div>
									<ul class="brands__list">
										{% assign collection = collections.muzhchinam %}

										{% assign brand_property = collection.properties | where: 'handle', 'brand' | first %}
										
										{% for brand in brands %}
											{% assign brand_char = brand_property.characteristics | where: 'handle', brand.link | first %}

											{% if brand_char.id %}
												<li class="brands__item">
													<a href="{{ collection.url | add_param: 'characteristics[]', brand_char.id }}" class="brands__link">{{ brand.title }}</a>
												</li>
											{% endif %}
										{% endfor %}
									</ul>
								</div>
							</div>
						</div>
					</nav>
				</div>
				<div class="gender__item">
					<a href="/page/women" class="item__link">Женщинам</a>
					<nav class="navigation">
						<div class="container">
							<div class="navigation__content">
								<div class="navigation__categories">
									<ul class="categories__list">
										{% for collection in women.subcollections %}
											<li class="categories__item">
												<a class="categories__link" href="{{ collection.url }}" tabindex="-1">{{ collection.title }}</a>
												
												{% if collection.subcollections.size > 0 %}
													<ul class="subcategories">
														{% for collection1 in collection.subcollections %}
															<li class="subcategories__item">
																<a href="{{ collection1.url }}" class="subcategories__link" tabindex="-1">
																	{{ collection1.title }}
																</a>
															</li>
					
															{% if collection1.subcollections.size > 0 %}
																<ul class="subcategories">
																{% for collection2 in collection1.subcollections %}
																	<li class="subcategories__item">
																		<a href="{{ collection2.url }}" tabindex="-1" class="subcategories__link">
																			{{ collection2.title }}
																		</a>
																	</li>
																{% endfor %}
																</ul>
															{% endif %}
														{% endfor %}
													</ul>
												{% endif %}
											</li>
										{% endfor %}
									</ul>
								</div>
								<div class="navigation__brands">
									<div class="brands__title">Бренды</div>
									<ul class="brands__list">
										{% assign collection = collections.zhenschinam %}

										{% assign brand_property = collection.properties | where: 'handle', 'brand' | first %}
										
										{% for brand in brands %}
											{% assign brand_char = brand_property.characteristics | where: 'handle', brand.link | first %}

											{% if brand_char.id %}
												<li class="brands__item">
													<a href="{{ collection.url | add_param: 'characteristics[]', brand_char.id }}" class="brands__link">{{ brand.title }}</a>
												</li>
											{% endif %}
										{% endfor %}
									</ul>
								</div>
							</div>
						</div>
					</nav>
				</div>

				<button class="left-menu__item" @click="sidebar = true; overflow = false">
					<img src="{{ 'ICO-burger.svg' | asset_url }}" alt="Иконка меню" class="left-menu__icon">
				</button>
				<button class="left-menu__item" @click="searchMobile = !searchMobile">
					<img src="{{ 'ICO-search.svg' | asset_url }}" alt="Иконка поиска" class="left-menu__icon">
				</button>
			</nav>
			<div class="logo">
				<a href="/" class="logo__link">
					<img src="{{ 'logo-main.svg' | asset_url }}" alt="limmite logo" class="logo__img">
				</a>
			</div>
			<div class="right-menu" @click.outside="search = false">
				<nav class="right-menu__icons" 
					x-show="!search"
					x-transition:enter="icons_enter"
					x-transition:enter-start="icons_enter-start"
					x-transition:enter-end="icons_enter-end"
					x-transition:leave="icons_leave"
				>
					<a 
						{% if client %}
							href="/client_account/orders"
						{% else %}
							href="/client_account/login" 
						{% endif %}
							class="right-menu__item right-menu__item_personal"
					>
						<img src="{{ 'ICO-profile.svg' | asset_url }}" alt="Иконка личного кабинета" class="right-menu__icon">
					</a>
					<a href="/favorites" class="right-menu__item"><img src="{{ 'ICO-heart-header.svg' | asset_url }}" alt="Иконка избранного" class="right-menu__icon"></a>
					<a href="/cart_items" class="right-menu__item right-menu__item_cart">
						<div class="items-number" 
							x-show="$store.cart.cart.items_count > 0" 
							x-text="$store.cart.cart.items_count"
							x-cloak
						>
							{{ cart.items_count }}
						</div>
						<img src="{{ 'ICO-cart.svg' | asset_url }}" alt="Иконка корзины" class="right-menu__icon">
					</a>
					<button class="right-menu__item right-menu__item_search" @click="search = true">
						<img src="{{ 'ICO-search.svg' | asset_url }}" alt="Иконка поиска" class="right-menu__icon">
					</button>
				</nav>
				<div class="right-menu__search" 
					x-show="search"
					x-transition:enter="search_enter"
					x-transition:enter-start="search_enter-start"
					x-transition:enter-end="search_enter-end"
					x-transition:leave="search_leave"
					x-cloak
				>
					<form action="/search">
						<input
							type="text"
							placeholder="Поиск"
							name="q"
							autocomplete="off"
						/>

						<img src="{{ 'ICO-search.svg' | asset_url }}" alt="Поиск" />
					</form>
				</div>
			</div>
			<div class="mobile-search" :class="searchMobile && 'mobile-search_active'">
				<div class="mobile-search__input">
					<input type="text" name="q" placeholder="Поиск">
					<img src="{{ 'ICO-search.svg' | asset_url }}" alt="">
				</div>
			</div>
		</div>
	</div>

	<div class="sidebar"
		:class="sidebar && 'sidebar_active'" 
		x-data="{
			page: 'men',
		}"
	>
			<div class="sidebar__header">
				<button class="header__button" :class="page === 'men' && 'header__button_active'" @click="page = 'men'">Мужчинам</button>
				<button class="header__button" :class="page === 'women' && 'header__button_active'" @click="page = 'women'">Женщинам</button>
				<div class="header__underline"></div>
			</div>
			<nav class="sidebar__categories">
				<ul class="sidebar__men-categories" x-show="page === 'men'">
					{% for collection in men.subcollections %}
						<li class="category" x-data="{
							show: false,
						}">
							<div class="category__header">
								<a href="{{ category.url }}" class="category__title">{{ collection.title }}</a>
								{% if collection.subcollections.size > 0 %}
									<button class="header__icon" :class="show && 'header__icon_active'" @click="show = !show">
										<img src="{{ 'ICO-arrow-down.svg' | asset_url }}" alt="Стрелка вниз">
									</button>
								{% endif %}
							</div>
							
							{% if collection.subcollections.size > 0 %}
								<div class="subcategories__wrap" :class="show && 'subcategories__wrap_active'">
									<div class="subcategories__content">
										<ul class="category__subcategories">
											{% for collection1 in collection.subcollections %}
												<li class="subcategories__item">
													<a href="{{ collection1.url }}" class="subcategories__link" tabindex="-1">
														{{ collection1.title }}
													</a>
												</li>
		
												{% if collection1.subcollections.size > 0 %}
													<ul class="subcategories">
													{% for collection2 in collection1.subcollections %}
														<li class="subcategories__item">
															<a href="{{ collection2.url }}" tabindex="-1" class="subcategories__link">
																{{ collection2.title }}
															</a>
														</li>
													{% endfor %}
													</ul>
												{% endif %}
											{% endfor %}
										</ul>
									</div>
								</div>
							{% endif %}
						</li>
					{% endfor %}
				</ul>
				<div class="sidebar__women-categories" x-show="page === 'women'">
					{% for collection in women.subcollections %}
						<li class="category" x-data="{
							show: false,
						}">
							<div class="category__header">
								<a href="{{ category.url }}" class="category__title">{{ collection.title }}</a>
								{% if collection.subcollections.size > 0 %}
									<button class="header__icon" :class="show && 'header__icon_active'" @click="show = !show">
										<img src="{{ 'ICO-arrow-down.svg' | asset_url }}" alt="Стрелка вниз">
									</button>
								{% endif %}
							</div>
							
							{% if collection.subcollections.size > 0 %}
								<div class="subcategories__wrap" :class="show && 'subcategories__wrap_active'">
									<div class="subcategories__content">
										<ul class="category__subcategories">
											{% for collection1 in collection.subcollections %}
												<li class="subcategories__item">
													<a href="{{ collection1.url }}" class="subcategories__link" tabindex="-1">
														{{ collection1.title }}
													</a>
												</li>
		
												{% if collection1.subcollections.size > 0 %}
													<ul class="subcategories">
													{% for collection2 in collection1.subcollections %}
														<li class="subcategories__item">
															<a href="{{ collection2.url }}" tabindex="-1" class="subcategories__link">
																{{ collection2.title }}
															</a>
														</li>
													{% endfor %}
													</ul>
												{% endif %}
											{% endfor %}
										</ul>
									</div>
								</div>
							{% endif %}
						</li>
					{% endfor %}
				</div>
			</nav>
			<div class="sidebar__footer">
				<a 
					{% if client %}
						href="/client_account/orders"
					{% else %}
						href="/client_account/login" 
					{% endif %}
						class="footer__button"
				>
					Личный кабинет
				</a>
			</div>
	</div>
	<div class="sidebar__cover" x-show="sidebar" @click="sidebar = false; overflow = true" x-cloak></div>
</header>

