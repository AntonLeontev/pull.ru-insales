<div id="cart_form" class="cart_section" 
	@to-cart.window="page = 'cart'"
    x-data="{
		page: 'cart',
      
		cartItemsForHuman() {
			let units =  this.$store.cart.cart?.items_count % 10

			if (units === 1) {
				return this.$store.cart.cart?.items_count + ' товар'
			}
			if (units > 1 && units <= 4) {
				return this.$store.cart.cart?.items_count + ' товара'
			}

			return this.$store.cart.cart?.items_count + ' товаров'
		},
		toCheckout() {
			this.page = 'checkout'
			document.querySelector('.breadcrumb').scrollIntoView({behavior: 'smooth'})
			this.$dispatch('to-checkout')
		},
    }"
  >
	<div class="container">
		<div class="cart" x-show="page === 'cart'">
			<div class="cart__items">
				<div class="cart__title">
					Ваш заказ
				</div>
				<template x-if="$store.cart.cart?.items_count === 0">
					<div class="">
						<h3>Корзина пуста</h3>
					</div>
				</template>
				<template x-for="item in $store.cart.cart.items">
					<div class="cart__item">
						<div class="item__image">
							<a :href="item.product_url">
								<img :src="item.product.images[0].large_url" :alt="item.title">
							</a>
							<div class="item__discount"
								x-show="$store.cart.getItemVariant(item)?.old_price > item.sale_price"
								x-text="'- '+$store.cart.getItemDiscount(item)+'%'"
							></div>
						</div>
						<div class="item__description">
							<div class="description__header">
								<a :href="item.product_url" class="item__title" x-text="item.product.title"></a>

								<button type="button" @click="$store.cart.removeItem(item)">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
