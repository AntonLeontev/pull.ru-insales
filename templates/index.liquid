		<section class="running_line swiper">
			<div class="swiper-wrapper">
				{% assign brands = block_lists.with_template['system-banner-3'].brands-runline.blocks %}

				{% if page.url contains 'page/zhen' %}	
					{% assign collection = collections.zhenschinam %}
				{% elsif page.url contains 'page/muzh' %} 
					{% assign collection = collections.muzhchinam %}
				{% else %} 
					{% assign collection = collections.all %}
				{% endif %} 

				{% assign brand_property = collection.properties | where: 'handle', 'brand' | first %}
				
				{% for brand in brands %}
					{% assign brand_char = brand_property.characteristics | where: 'handle', brand.link | first %}

					<div class="swiper-slide">
						<a href="{{ collection.url | add_param: 'characteristics[]', brand_char.id }}">
							<img class="brand-logo" src="{{ brand.image }}" alt="{{ brand.title }}"/>
						</a>
					</div>
					{% if brand_char.id %}
					{% endif %}
				{% endfor %}
			</div>
		</section>

		<section class="new-products">
			<div class="new-products__header">
				<div class="header__title">Новые поступления</div>
			</div>
			<div
				class="swiper home__products-swiper"
			>
				<!-- Additional required wrapper -->
				<div
					class="swiper-wrapper"
					aria-live="polite"
				>
					<!-- Slides -->
					{% if page.url contains 'page/muzh' %}
						{% assign block_new = blocks.with_template['system-collection'].novinki-muzhchinam %}
					{% elsif page.url contains 'page/zhen' %}
						{% assign block_new = blocks.with_template['system-collection'].novinki-zhenschinam %}
					{% else %}
						{% assign block_new = blocks.with_template['system-collection'].kollektsiya-novinki-blok-1 %}
					{% endif %}
	
					{%for product in collections[block_new.collection.handle].products %}
					<div class="swiper-slide">
						<div class="swiper__card">
							<div class="card__top">
								<div class="card__image-container">
									<a href="{{ product.url }}">
										<img  class="card__image" src="{{ product.first_image.large_url }}" alt="{{ product.title }}"/>
									</a>
								</div>
								<div class="card__text">
									<a href="{{ product.url }}" class="card__title">
										{{ product.title }}
									</a>
								</div>
							</div>
							<div class="card__price">
								{{ product.price | money }}
							</div>
						</div>
					</div>
					{% endfor %} 
				</div>
	
			</div>
			<div class="swiper-nav">
				<button class="swiper-button_prev home__products-swiper-button_prev">
				   <svg width="32" viewBox="0 0 15 8" fill="none" xmlns="http://www.w3.org/2000/svg">
					   <path d="M0.646446 4.35355C0.451184 4.15829 0.451184 3.84171 0.646446 3.64645L3.82843 0.464467C4.02369 0.269205 4.34027 0.269205 4.53553 0.464467C4.7308 0.659729 4.7308 0.976312 4.53553 1.17157L1.70711 4L4.53553 6.82843C4.7308 7.02369 4.7308 7.34027 4.53553 7.53553C4.34027 7.7308 4.02369 7.7308 3.82843 7.53553L0.646446 4.35355ZM15 4.5L1 4.5L1 3.5L15 3.5L15 4.5Z" fill="#111111"/>
				   </svg>
				</button>
				<button class="swiper-button_next home__products-swiper-button_next">
				   <svg width="32" viewBox="0 0 15 8" fill="none" xmlns="http://www.w3.org/2000/svg">
					   <path d="M14.3536 4.35355C14.5488 4.15829 14.5488 3.84171 14.3536 3.64645L11.1716 0.464467C10.9763 0.269205 10.6597 0.269205 10.4645 0.464467C10.2692 0.659729 10.2692 0.976312 10.4645 1.17157L13.2929 4L10.4645 6.82843C10.2692 7.02369 10.2692 7.34027 10.4645 7.53553C10.6597 7.7308 10.9763 7.7308 11.1716 7.53553L14.3536 4.35355ZM-4.68336e-08 4.5L14 4.5L14 3.5L4.68336e-08 3.5L-4.68336e-08 4.5Z" fill="#111111"/>
				   </svg>
				</button>
			</div>
		</section>

		<section class="home__banner">
			<img src="{{ 'home_banner01.webp' | asset_url }}" alt="" class="banner__image">
			<div class="banner__text">
				<div class="title">Дарим скидку 5% на первую покупку</div>
				<div class="text">Регистрируйтесь – узнавайте о новинках и специальных предложениях первыми</div>
				<button class="button" @click="$dispatch('open-register')">Получить скидку</button>
			</div>
		</section>

		<section class="home__brands">
			<div class="brand">
				<img src="{{ 'home_moncler.webp' | asset_url }}" alt="" class="brand__image">
				<div class="brand__description">
					<div class="top">
						<div class="subtitle">Новая коллекция</div>
						<div class="title">MONCLER</div>
					</div>
					<a href="https://limmite.ru/collection/all?price_min=&price_max=&characteristics%5B%5D=229762760" class="button">Смотреть</a>
				</div>
			</div>
			<div class="brand">
				<img src="{{ 'home_boss.webp' | asset_url }}" alt="" class="brand__image">
				<div class="brand__description">
					<div class="top">
						<div class="subtitle">Новая коллекция</div>
						<div class="title">Boss</div>
					</div>
					<a href="https://limmite.ru/collection/all?price_min=&price_max=&characteristics%5B%5D=228915284" class="button">Смотреть</a>
				</div>
			</div>
		</section>

		<section class="home__benefits">
			<div class="benefit">
				<img src="{{ 'home_icon01.svg' | asset_url }}" class="benefit__image" />
				<div class="benefit__title">Контролируем каждую отправку</div>
				<div class="benefit__text">Проверяем упаковку и внешний вид товара</div>
			</div>
			<div class="benefit">
				<img src="{{ 'home_icon02.svg' | asset_url }}" class="benefit__image" />
				<div class="benefit__title">Уникальные бренды в наличии в&nbsp;России</div>
				<div class="benefit__text"> Быстрая доставка, примерка дома или в магазинах в&nbsp;Москве.</div>
			</div>
			<div class="benefit">
				<img src="{{ 'home_icon03.svg' | asset_url }}" class="benefit__image" />
				<div class="benefit__title">Fashion-стилисты в команде</div>
				<div class="benefit__text">Поможем с выбором идеального гардероба.</div>
			</div>
		</section>

		<section class="home__black-banner">
			<picture class="banner__image">
				<source srcset="{{ 'home_banner02_mob.webp' | asset_url }}" media="(max-width: 768px)">
				<img src="{{ 'home_banner02.webp' | asset_url }}" alt="banner" class="banner__image">
			</picture>
			<div class="banner__description">
				<div class="wrap">
					<div class="description">
						<div class="title">Доставка с примеркой</div>
						<div class="text">Домой или пункт выдачи</div>
					</div>
					<hr>
					<div class="description">
						<div class="title">Платите где хотите</div>
						<div class="text">При оформлении товара или после примерки</div>
					</div>
				</div>
			</div>
		</section>

		<section class="home__form">
			<div class="subtitle">экспресс консультация стилиста под ваш запрос</div>
			<div class="title">Получите персональную консультацию стилиста</div>
			<form class="form" @submit.prevent="submit" 
				x-data="{
					processing: false,

					submit(e) {
						this.processing = true

						let data = new FormData(e.target)
						$.post('https://app.limmite.ru/api/stylist-subscribe', Object.fromEntries(data.entries()))
							.done(done => e.target.querySelector('button span').innerText = '✓')
							.fail(err => console.log(err))
							.always(() => {
								e.target.reset()
								this.processing = false
							})
					},
				}"
			>
				<div class="wrap">
					<input type="email" name="email" placeholder="Введите ваш E-mail" required>
					<button>
						<span x-show="!processing">Отправить</span>
						<img src="{{ 'loading-white.svg' | asset_url }}" height="20px" width="20px" alt="loading" x-show="processing" x-cloak>
					</button>
				</div>
				<div class="radio-wrap">
					<label>
						<input type="radio" name="sex" value="1" checked>
						<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="empty">
							<circle cx="7" cy="7" r="6.5" fill="white" stroke="#939393"/>
						</svg>
						<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="filled">
							<circle cx="7" cy="7" r="6.5" fill="white" stroke="#131313"/>
							<circle cx="7" cy="7" r="4" fill="#131313"/>
						</svg>
						<span>Для мужчин</span>
					</label>
					<label>
						<input type="radio" name="sex" value="2">
						<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="empty">
							<circle cx="7" cy="7" r="6.5" fill="white" stroke="#939393"/>
						</svg>
						<svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" class="filled">
							<circle cx="7" cy="7" r="6.5" fill="white" stroke="#131313"/>
							<circle cx="7" cy="7" r="4" fill="#131313"/>
						</svg>
						<span>Для женщин</span>
					</label>
				</div>
			</form>
			<div class="text">
				Нажимая «Отправить» вы даёте согласие на <a target="_blank" href="https://static.insales-cdn.com/files/1/3325/33565949/original/policy.pdf">обработку персональных данных</a>
			</div>
		</section>
	</div>
</div>

<div class="popup-cover" :class="show && 'popup-cover_active'" x-data="{
	show: false,
	processing: false,
	errors: {},

	submit(e) {
		this.processing = true;
		this.errors = {};

		let data = new FormData(e.target)
		$.post('https://app.limmite.ru/api/register-from-main', Object.fromEntries(data.entries()))
			.done(done => {
				e.target.reset()
				e.target.querySelector('button span').innerText = '✓'
			})
			.fail(err => {
				if (err.status === 422) {
					this.errors = err.responseJSON.errors
					return;
				}

				e.target.reset()
				console.log(err)
			})
			.always(() => {
				this.processing = false
			})
	},
	format(e) {
		if (e.target.value.length >= 2) {
			return
		}

		e.target.value = '+7';
	},
}"
@open-register.window="show = true"
>
	<div class="popup popup_register" x-show="show" x-transition.opacity>
		<div class="popup__header">
			<div class="">
				<div class="header__title">Получите скидку на первый заказ</div>
				<div class="header__subtitle">Подпишитесь на наши новости и спецпредложения</div>
			</div>
			<button class="header__close" aria-label="Кнопка закрыть модальное окно" @click="show = false">
				<img src="{{ 'ICO-close.svg' | asset_url }}" alt="close button">
			</button>
		</div>
		<div class="popup__body">
			<form class="body__form" @submit.prevent="submit">
				<input type="text" name="name" placeholder="Имя" required>
				<div class="error" :class="errors?.name && 'error_active'" x-text="errors.name?.join('')">Error</div>
				<input type="email" name="email" placeholder="Email" required>
				<div class="error" :class="errors?.email && 'error_active'" x-text="errors.email?.join('')">Error</div>
				<input type="phone" name="phone" placeholder="Номер телефона" value="+7" required x-mask="+7(999)999-99-99" @input="format">
				<div class="error" :class="errors?.phone && 'error_active'" x-text="errors.phone?.join('')">Error</div>
				<button :disabled="processing">
					<span x-show="!processing">Получить скидку</span>
					<img src="{{ 'loading-white.svg' | asset_url }}" height="20px" width="20px" alt="loading" x-show="processing" x-cloak>
				</button>
			</form>
			<div class="text">
				Нажимая "Получить скидку", вы даёте согласие на <a target="_blank" href="https://static.insales-cdn.com/files/1/3325/33565949/original/policy.pdf">обработку персональных данных</a>
			</div>
		</div>
	</div>
</div>

