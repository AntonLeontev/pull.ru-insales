				</div>
			</div>
		</section>
		<section class="running_line swiper">
			<div class="swiper-wrapper">
				{% assign brands = block_lists.with_template['system-banner-3'].brands-runline.blocks %}

				{% if page.url contains 'page/zhen' %}	
					{% assign collection = collections.zhenschinam %}
				{% elsif page.url contains 'page/muzh' %} 
					{% assign collection = collections.muzhchinam %}
				{% else %} 
					{% assign collection = collections.all %}
				{% endif %} 

				{% assign brand_property = collection.properties | where: 'handle', 'brand' | first %}
				
				{% for brand in brands %}
					{% assign brand_char = brand_property.characteristics | where: 'handle', brand.link | first %}

					<div class="swiper-slide">
						<a href="{{ collection.url | add_param: 'characteristics[]', brand_char.id }}">
							<img class="brand-logo" src="{{ brand.image }}" alt="{{ brand.title }}"/>
						</a>
					</div>
					{% if brand_char.id %}
					{% endif %}
				{% endfor %}
			</div>
		</section>

		<div
			class="swiper products_swiper_2 swiper-initialized swiper-horizontal swiper-backface-hidden"
		>
			<!-- Additional required wrapper -->
			<div
				id="swiper-wrapper-c817f23c6510735be"
				class="swiper-wrapper"
				aria-live="polite"
			>
				<!-- Slides -->
				{% if page.url contains 'page/muzh' %}
				{% assign block_new = blocks.with_template['system-collection'].novinki-muzhchinam %}
				{% elsif page.url contains 'page/zhen' %}
				{% assign block_new = blocks.with_template['system-collection'].novinki-zhenschinam %}
				{% else %}
				{% assign block_new = blocks.with_template['system-collection'].kollektsiya-novinki-blok-1 %}
				{% endif %}

				{%for product in collections[block_new.collection.handle].products %}
				<div class="swiper-slide">
				<div class="product_slide_card">
					<div class="product_card_img">
					<a href="{{ product.url }}" class="link_more"
						><img src="{{ product.first_image.large_url }}" alt=""
					/></a>
					</div>
					<div class="product_card_itext">
					<a href="{{ product.url }}" class="product_card_name">
						{{ product.title }}
					</a>
					<div class="product_card_prices">
						<div class="product_card_price">
						{{ product.price | money }}
						</div>
						<div class="product_card_old_price">
						{{ product.old_price | money }}
						</div>
					</div>
					</div>
				</div>
				</div>
				{% endfor %} 
			</div>

			<!-- If we need navigation buttons -->
			<div class="swiper-button-prev"></div>
			<div class="swiper-button-next"></div>
			<span
				class="swiper-notification"
				aria-live="assertive"
				aria-atomic="true"
			></span>
		</div>
	</div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const runningLine = new Swiper(".running_line", {
      spaceBetween: 0,
      centeredSlides: true,
      speed: 3000,
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
      },
      loop: true,
      loopedSlides: 4,
      slidesPerView:'auto',
      allowTouchMove: true,
    });

	setTimeout(() => {
		console.log('runningLine', runningLine.autoplay.running);
		runningLine.autoplay.resume()
	}, 300);
  })
</script>


