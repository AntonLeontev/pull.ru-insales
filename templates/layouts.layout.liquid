<!DOCTYPE html>
<html lang="ru">
	<head>
		{% include "head" %}
	</head>
	<body id="body" :class="overflow || 'ovhidden'" x-data="{overflow: true}">
		<div class="wrapper">

			{% include "header" %}

			<main class="main {% if template == 'index' %} main-index {% endif %}">
				
				{% unless template contains 'index' or page.url contains 'page/muzh' or page.url contains 'page/zhen' %}	
					{% include "breadcrumbs" %}
				{% endunless %}  
				
				{{ content_for_layout }}

			</main>

			{% include "footer" %}

			{% include "toasts" %}

		
		</div>
		
		{% include "alpine-cart-store" %}
		<!-- swiper -->
		<script src="{{ 'swiper10.js' | asset_url }}"></script>

		<script src="{{ 'nice-select2.js' | asset_url }}"></script>

		<!-- главый js -->
		<script src="{{ 'main.js?v=2' | asset_url }}"></script>
		<script src="{{ 'helpers.js' | asset_url }}"></script>
		{% include "microdata" %}

	</body>
</html>
